<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sebra82 // Quantum Interactive Design</title>
    <style>
        :root {
            --bg-color: #05070a;
            --accent-glow: rgba(0, 243, 255, 0.15);
            --neon-cyan: #00f3ff;
            --neon-green: #00ff66;
            --text-muted: #64748b;
            --panel-bg: rgba(13, 18, 30, 0.75);
            --border-color: rgba(0, 243, 255, 0.2);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: #e2e8f0;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
            background-image: 
                linear-gradient(rgba(0, 243, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 243, 255, 0.03) 1px, transparent 1px);
            background-size: 20px 20px;
        }

        .console-container {
            width: 90%;
            max-width: 700px;
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 25px;
            box-shadow: 0 0 30px var(--accent-glow);
            backdrop-filter: blur(10px);
            position: relative;
        }

        .console-container::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, transparent, var(--neon-cyan), transparent);
        }

        header {
            border-bottom: 1px dashed var(--border-color);
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .core-spec {
            font-size: 1.1rem;
            font-weight: bold;
            color: var(--neon-cyan);
            text-shadow: 0 0 8px rgba(0, 243, 255, 0.5);
            letter-spacing: 1px;
        }

        .legal-tag {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .engine-status {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 12px;
            font-size: 0.85rem;
            color: var(--neon-green);
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: var(--neon-green);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--neon-green);
            animation: pulse 1.5s infinite ease-in-out;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.4; transform: scale(0.9); }
            50% { opacity: 1; transform: scale(1.1); }
        }

        /* Interactive Waveform Canvas */
        #waveCanvas {
            width: 100%;
            height: 80px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(0, 243, 255, 0.1);
            border-radius: 4px;
            margin-bottom: 20px;
        }

        .telemetry-grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .metric-card {
            background: rgba(0, 0, 0, 0.2);
            border-left: 3px solid var(--neon-cyan);
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease;
        }

        .metric-card:hover {
            background: rgba(0, 243, 255, 0.04);
            border-left-color: var(--neon-green);
            transform: translateX(4px);
        }

        .metric-label {
            font-size: 0.85rem;
            color: #94a3b8;
        }

        .metric-value {
            font-weight: bold;
            font-size: 0.95rem;
            color: #f1f5f9;
        }

        .highlight-blue { color: var(--neon-cyan); }
        .highlight-green { color: var(--neon-green); }
    </style>
</head>
<body>

    <div class="console-container">
        <header>
            <div class="core-spec">M4 Ultra // M4P</div>
            <div class="legal-tag">GPU_RENDER_CORE // DTSA_18_USC_1836</div>
            <div class="engine-status">
                <div class="pulse-dot"></div>
                <span>Ψ(t) PARALLEL GPU SHADER ENGINE ONLINE</span>
            </div>
        </header>

        <!-- Real-time Quantum Wave Simulation -->
        <canvas id="waveCanvas"></canvas>

        <main class="telemetry-grid">
            <div class="metric-card">
                <span class="metric-label">1. Entanglement Entropy</span>
                <span class="metric-value highlight-green" id="entropyVal">0.0000 S_vN</span>
            </div>
            <div class="metric-card">
                <span class="metric-label">2. Phase Propagation</span>
                <span class="metric-value highlight-blue" id="phaseVal">0.0040 r/s</span>
            </div>
            <div class="metric-card">
                <span class="metric-label">3. Hilbert Subspace</span>
                <span class="metric-value">2⁵⁰⁰ VIRTUAL STATES</span>
            </div>
            <div class="metric-card">
                <span class="metric-label">4. EWC Neural Link</span>
                <span class="metric-value highlight-green">EMBEDDED</span>
            </div>
        </main>
    </div>

    <script>
        // Setup Simulated Quantum Wave Canvas
        const canvas = document.getElementById('waveCanvas');
        const ctx = canvas.getContext('2d');
        
        function resizeCanvas() {
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        let increment = 0;
        function animateWave() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw baseline grid lines inside canvas
            ctx.strokeStyle = 'rgba(0, 243, 255, 0.05)';
            ctx.lineWidth = 1;
            for(let i = 0; i < canvas.height; i += 20) {
                ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(canvas.width, i); ctx.stroke();
            }

            // Draw Schrodinger Wave Function Representation
            ctx.beginPath();
            ctx.strokeStyle = '#00f3ff';
            ctx.lineWidth = 1.5;
            ctx.shadowBlur = 4;
            ctx.shadowColor = '#00f3ff';

            for (let x = 0; x < canvas.width; x++) {
                // Generate complex overlapping sine waves to mimic quantum state propagation
                const y = canvas.height / 2 + 
                          Math.sin(x * 0.02 + increment) * 15 * Math.sin(increment * 0.5) +
                          Math.cos(x * 0.01 - increment * 0.7) * 8;
                if (x === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();
            ctx.shadowBlur = 0; // Reset shadow

            increment += 0.04;
            requestAnimationFrame(animateWave);
        }
        animateWave();

        // Active Telemetry Logic: Fluctuating Real-Time Values
        const entropyEl = document.getElementById('entropyVal');
        const phaseEl = document.getElementById('phaseVal');
        let basePhase = 0.0040;

        setInterval(() => {
            // Entanglement Entropy occasionally experiences tiny quantum fluctuations
            const entropyChance = Math.random();
            if (entropyChance > 0.85) {
                const microFluctuation = (Math.random() * 0.0004).toFixed(4);
                entropyEl.innerText = `${microFluctuation} S_vN`;
            } else {
                entropyEl.innerText = `0.0000 S_vN`;
            }

            // Phase propagation rotates and scales continuously
            basePhase += (Math.random() - 0.5) * 0.0005;
            if (basePhase < 0.001) basePhase = 0.0040; // Clamping bounds
            phaseEl.innerText = `${basePhase.toFixed(4)} r/s`;
        }, 300);
    </script>
</body>
</html>
